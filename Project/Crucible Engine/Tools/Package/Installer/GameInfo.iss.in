; The name and version can be overridden on ISCC's command line (/DAppName=... /DAppVersion=...).
#ifndef AppName
  #define AppName "@CRUCIBLE_GAME_NAME@"
#endif
#ifndef AppVersion
  #define AppVersion "@CRUCIBLE_GAME_VERSION@"
#endif

#define AppPublisher  "@CRUCIBLE_GAME_PUBLISHER@"
; The folder under Program Files the game goes in (may be empty: straight into Program Files).
#define InstallFolder "@CRUCIBLE_GAME_INSTALL_FOLDER@"

; Never overridden: it must stay the same for every build of the game.
#define AppGuid "@CRUCIBLE_GAME_APP_ID@"
