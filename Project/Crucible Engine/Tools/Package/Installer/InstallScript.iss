; TCR compliant install script for the game.
; Based on DigiPen's sample install script. Thanks to Dan Weiss (dweiss@digipen.edu) for the
; original version.
;
; How it is built
;   File > Package Game in the Editor fills GAMEDIRECTORY (cmake --install ... --component Game)
;   and runs the Inno Setup 6 compiler on this file, passing the version typed in its window:
;
;     ISCC.exe /DAppVersion=0.1.0 /DOutputDir=... InstallScript.iss
;
;   It can also be opened in the Inno Setup app and compiled there, once GAMEDIRECTORY is filled.
;
; Where the name, version and AppId come from
;   CRUCIBLE_GAME_NAME, CRUCIBLE_GAME_VERSION and CRUCIBLE_GAME_APP_ID in the top-level
;   CMakeLists.txt. run.bat writes them into GameInfo.iss next to this file, which is included
;   below. Change them there, never here.
;
; Folders next to this file
;   GAMEDIRECTORY\   the game exactly as it is installed into Program Files (filled by the build, not in git)
;   INSTALLERFILES\  the DigiPen EULA and the icon (in git)
;   REDIST\          VC_redist.x64.exe, from Microsoft or the DigiPen sample (not in git)
;   INSTALLER\       where the finished setup .exe goes by default (not in git)

; ---- The game's name, version and AppId (GameInfo.iss, generated by CMake) --------------------
#if !FileExists(AddBackslash(SourcePath) + "GameInfo.iss")
  #error GameInfo.iss is missing. Run run.bat (it writes GameInfo.iss from the top-level CMakeLists.txt).
#endif
#include "GameInfo.iss"

#ifndef OutputDir
  #define OutputDir ".\INSTALLER"
#endif
#define AppExeName AppName + ".exe"
#define AppIcon    "LithoLogo.ico"

[Setup]
; !!NOTE!!: The value of AppId uniquely identifies this application. Windows uses it to tell that
; a new version is the same game (and upgrade it in place), so it NEVER changes - not for a new
; version, and not if the game is renamed. It is CRUCIBLE_GAME_APP_ID in the top-level
; CMakeLists.txt. The first { is doubled: Inno Setup reads {{ as one {.
AppId={{{#AppGuid}}

; Standard app data stuff
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} Version {#AppVersion}
AppPublisher=DigiPen Institute of Technology
AppPublisherURL=http://www.digipen.edu/
AppSupportURL=http://www.digipen.edu/

; Default install folder. {autopf} is Program Files for an install for all users, or the user's
; own Programs folder (AppData\Local\Programs) for an install without admin rights.
DefaultDirName={autopf}\DigiPen\{#AppName}

; Start menu directory
DefaultGroupName=DigiPen\{#AppName}

; Output directory and file name for the installer.
OutputDir={#OutputDir}
OutputBaseFilename={#AppName}_Setup

; Path to the DigiPen EULA (Needed to pass TCRs)
LicenseFile=INSTALLERFILES\DigiPen_EULA.txt

; Path to the icon for the installer (TCR check requires custom icon)
SetupIconFile=INSTALLERFILES\{#AppIcon}
; The icon shown for the game in Settings > Apps
UninstallDisplayIcon={app}\{#AppIcon}

; Compression scheme for the installer. Check Inno Setup help files for more options.
Compression=lzma
SolidCompression=yes

; Runs without admin rights by default (so it installs on Sandbox or other test machines), and
; lets the player choose "for all users" instead, which asks for admin rights and installs into
; Program Files. The game writes nothing into its install folder (settings, the log and caches go
; to %LOCALAPPDATA%\<game name>), so it runs from either place.
PrivilegesRequired=lowest
PrivilegesRequiredOverridesAllowed=dialog

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Tasks]
; Creates an installer option to allow/disallow desktop shortcut
; Checked by default
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

; This is the list of files that the installer should grab and install.
;
; Destination Directory Notes
;   {app} is the root directory that you will be installing to.
;   {tmp} is a temporary directory that Windows sets that gets deleted after the
;      installer quits.
[Files]
; The game directory is exactly what the install directory looks like
Source: GAMEDIRECTORY\*; DestDir: {app}; Flags: ignoreversion recursesubdirs createallsubdirs
; The icon, for the shortcuts and Settings > Apps
Source: INSTALLERFILES\{#AppIcon}; DestDir: {app}; Flags: ignoreversion
; The Visual C++ redistributable, run from the temporary directory (see [Run])
Source: REDIST\VC_redist.x64.exe; DestDir: {tmp}; Flags: ignoreversion deleteafterinstall

; This is the list of shortcuts that the installer will setup for you.
; Of note, this will create the uninstaller automatically.
;
; Directory Notes
;   {group} is the start menu location that the game will install shortcuts to.
;   {autodesktop} is the desktop: all users' for an install for all users, else the player's own.
[Icons]
Name: {group}\{#AppName}; Filename: {app}\{#AppExeName}; WorkingDir: {app}; IconFilename: "{app}\{#AppIcon}"
Name: {group}\{cm:UninstallProgram,{#AppName}}; Filename: {uninstallexe}; IconFilename: "{app}\{#AppIcon}"
Name: {autodesktop}\{#AppName}; Filename: {app}\{#AppExeName}; Tasks: desktopicon; WorkingDir: {app}; IconFilename: "{app}\{#AppIcon}"

; List of items to execute in the installer.
; Note that this will run all executables in their silent versions as required by the TCRs.
;
; The VC++ redistributable needs admin rights, so it only runs for an install for all users. The
; game does not depend on it: the same runtime DLLs are installed beside the .exe.
;
; The last item being run is the installer option to automatically launch the game after
;   the installer exits as required by the TCRs.
[Run]
Filename: {tmp}\VC_redist.x64.exe; Parameters: /install /quiet /norestart; StatusMsg: Installing Visual C++ Redistributable...; Flags: waituntilterminated; Check: IsAdminInstallMode
Filename: {app}\{#AppExeName}; Description: {cm:LaunchProgram,{#AppName}}; Flags: nowait postinstall skipifsilent

; Additional files to delete when uninstaller runs: the player's settings, log and caches.
[UninstallDelete]
Type: filesandordirs; Name: "{localappdata}\{#AppName}"
